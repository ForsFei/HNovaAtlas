<Window x:Class="IndustrialModbusMonitor.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Modbus 监控与模拟目标写入 · 仅本机" Width="850" Height="650"
 MinWidth="700" MinHeight="530" Closing="OnClosing">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal">
   <ComboBox x:Name="Fault" Width="210" AutomationProperties.Name="模拟写入故障"/>
   <Button x:Name="Start" Content="启动本机轮询" Click="OnStart" Padding="14,7" Margin="12,0"/>
   <Button x:Name="Stop" Content="停止" Click="OnStop" IsEnabled="False" Padding="14,7"/>
  </StackPanel>
  <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,12"
   Text="仅访问内置 127.0.0.1 设备。每轮独立连接，读写串行；写入只修改模拟目标，不控制现场输出。"/>
  <StackPanel Grid.Row="2">
   <TextBlock x:Name="State" Text="Stopped" FontSize="18"/>
   <TextBlock x:Name="Values" Text="无有效采样" TextWrapping="Wrap" FontSize="21" Margin="0,10"/>
   <TextBlock x:Name="Raw" Text="IR0～2 原始寄存器：—；Float32 契约 ABCD"/>
   <TextBlock x:Name="Detail" TextWrapping="Wrap" Margin="0,6,0,12"/>
  </StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6">
   <TextBlock Text="模拟目标（0～100，步进 0.1）：" VerticalAlignment="Center"/>
   <TextBox x:Name="Target" Text="30.0" Width="90" AutomationProperties.Name="模拟目标值"/>
   <Button x:Name="Write" Content="写入一次" Click="OnWrite" IsEnabled="False" Padding="14,6" Margin="12,0"/>
  </StackPanel>
  <TextBlock Grid.Row="4" x:Name="Receipt" Text="尚无写入。" TextWrapping="Wrap" Margin="0,8,0,12"/>
  <ListBox Grid.Row="5" ItemsSource="{Binding History}" FontFamily="Consolas" AutomationProperties.Name="轮询与写入记录"/>
 </Grid>
</Window>
