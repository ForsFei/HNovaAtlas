<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Mono8Image.cs;../PlainPgm.cs;../OfflineFrameSource.cs;../SingleCaptureSession.cs;../InspectionPipeline.cs;../PlanarCalibration.cs;../ImageDisplay.cs" Link="Core/%(Filename)%(Extension)" />
    <None Include="../fixtures/contrast-target.pgm" Link="fixtures/contrast-target.pgm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
