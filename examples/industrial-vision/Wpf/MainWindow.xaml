<Window x:Class="IndustrialVision.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IndustrialVision.Wpf"
        Title="HNova Atlas · 离线视觉显示" Width="940" Height="740" MinWidth="600" MinHeight="520"
        Background="#F4F6F9" FontFamily="Microsoft YaHei UI" Closing="OnClosing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="离线图像与同帧结果" FontSize="24" FontWeight="SemiBold" Foreground="#152238" />
            <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Foreground="#536176"
                       Text="固定合成灰度图；无相机、PLC或运动。青色框仅为预设统计ROI，不代表产品合格。处理延迟400ms仅用于演示。" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Button x:Name="NextButton" Content="下一帧（离线）" Click="OnNext" Padding="14,8" Margin="0,0,10,0" />
            <Button x:Name="ProcessButton" Content="处理当前帧" Click="OnProcess" Padding="14,8" Margin="0,0,10,0" />
            <Button x:Name="ClearButton" Content="清空显示" Click="OnClear" Padding="14,8" />
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock x:Name="FrameText" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#152238" />
            <TextBlock x:Name="ResultText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#23526B" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#536176" />
        </StackPanel>
        <Border Grid.Row="3" BorderBrush="#D1D8E3" BorderThickness="1">
            <local:Mono8Viewer x:Name="Viewer" MouseLeftButtonDown="OnImageClick" />
        </Border>
        <TextBlock Grid.Row="4" x:Name="PixelText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#536176"
                   Text="点击图像查看原图像素；黑色留白不可选。点击不会生成毫米测量或运动。" />
    </Grid>
</Window>
