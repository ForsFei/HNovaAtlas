<Window x:Class="WpfCommandValidation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备阈值 · 命令与输入验证" Width="480" Height="330"
        MinWidth="400" MinHeight="300">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="设备报警阈值" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,12,0,0"
                   Text="{Binding CurrentThreshold, StringFormat=当前已应用：{0} °C}" />

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="新阈值（0–100 的整数）" />
            <TextBox Margin="0,6,0,0" AutomationProperties.Name="新阈值">
                <TextBox.Text>
                    <Binding Path="ThresholdText" Mode="TwoWay"
                             UpdateSourceTrigger="PropertyChanged"
                             ValidatesOnDataErrors="True" />
                </TextBox.Text>
            </TextBox>
            <TextBlock Text="{Binding ErrorText}" Foreground="Firebrick"
                       Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="应用" Command="{Binding ApplyCommand}" Padding="18,7" />
            <Button Content="取消编辑" Command="{Binding CancelCommand}"
                    Margin="10,0,0,0" Padding="18,7" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="0,18,0,0"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
