<Window x:Class="WpfListPerformance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF 列表与虚拟化对照" Width="760" Height="620" MinWidth="520" MinHeight="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="3,000 条内存读数：筛选、排序与 UI 虚拟化" FontSize="19" FontWeight="SemiBold" />
        <WrapPanel Grid.Row="1" Margin="0,14,0,10" VerticalAlignment="Center">
            <TextBlock Text="设备包含" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="DeviceQuery" Width="120" TextChanged="Filter_Changed" Margin="0,0,16,0" />
            <CheckBox x:Name="AlertsOnly" Content="仅报警" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,16,0" VerticalAlignment="Center" />
            <CheckBox x:Name="DescendingSort" Content="温度降序" IsChecked="True" Checked="Sort_Changed" Unchecked="Sort_Changed" Margin="0,0,16,0" VerticalAlignment="Center" />
            <CheckBox x:Name="VirtualizationToggle" Content="启用 UI 虚拟化" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" />
            <Button Content="刷新计数" Click="Measure_Click" Padding="10,4" />
        </WrapPanel>
        <TextBlock x:Name="Diagnostics" Grid.Row="2" Margin="0,0,0,10" TextWrapping="Wrap" />
        <ListBox x:Name="ReadingsList" Grid.Row="3"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="{Binding IsChecked, ElementName=VirtualizationToggle}"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Id, StringFormat=编号 {0}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Device}" />
                        <TextBlock Grid.Column="2" Text="{Binding Temperature, StringFormat=温度 {0} ℃}" />
                        <TextBlock Grid.Column="3" Text="{Binding IsAlert, StringFormat=报警 {0}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
