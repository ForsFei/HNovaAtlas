{
  "name": "hnova-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts --port 43110",
    "prepare:content": "tsx scripts/prepare-content.ts",
    "prebuild": "npm run prepare:content",
    "build": "next build",
    "postbuild": "npm run build:search",
    "build:search": "pagefind",
    "start": "serve out -l 43110",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "tsx scripts/prepare-content.ts --if-missing",
    "typecheck": "tsc --noEmit",
    "test:content": "tsx --test tests/content.test.ts tests/home.test.ts tests/search.test.ts tests/mdx.test.tsx tests/interactive.test.tsx tests/performance.test.ts tests/pdo-lab.test.ts tests/tags.test.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.6",
    "@shikijs/rehype": "^4.4.3",
    "dompurify": "^3.4.16",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.0.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chokidar": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "pagefind": "^1.5.2",
    "serve": "^14.2.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
